{
    "name": "dorafiles/app",
    "description": "Dora Files - FTP to Web Bridge",
    "type": "project",
    "require": {
        "php": "^8.1",
        "ext-ftp": "*",
        "ext-openssl": "*",
        "ext-pdo": "*",
        "endroid/qr-code": "^6.0",
        "spomky-labs/otphp": "^11.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "files": [
            "app/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test-coverage": "phpunit --coverage-html coverage"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    }
}
