# Application Configuration
APP_NAME="Dora Files"
APP_ENV=production
APP_URL=https://your-domain.com
# Generate with: php -r "echo 'base64:' . base64_encode(random_bytes(32)) . PHP_EOL;"
APP_ENCRYPTION_KEY=base64:CHANGE_THIS_TO_RANDOM_32_BYTE_KEY

# Database Configuration
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=your_database_name
DB_USERNAME=your_database_user
DB_PASSWORD=your_database_password

# FTP Configuration
FTP_TIMEOUT=10

# File Upload Configuration
MAX_FILE_SIZE=2147483648
# Allowed MIME types (comma-separated, supports prefix matching)
ALLOWED_FILE_TYPES=image/,video/,audio/,application/pdf,application/zip,application/msword,application/vnd.openxmlformats-officedocument,text/

# Rate Limiting Configuration
DOWNLOAD_RATE_LIMIT=10

# Session Configuration
SESSION_LIFETIME=120
SESSION_COOKIE=dorafiles_session

# Security Configuration
# Trusted proxy IPs (comma-separated) - only set if behind reverse proxy
# Example: TRUSTED_PROXIES=127.0.0.1,10.0.0.1
TRUSTED_PROXIES=

# Activity Log Retention (days)
ACTIVITY_LOG_RETENTION_DAYS=90
